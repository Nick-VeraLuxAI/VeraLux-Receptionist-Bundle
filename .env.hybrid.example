# =============================================================================
# VeraLux — HYBRID profile (operator-defined split — SKELETON)
# =============================================================================
# Compose does not fully automate split regions. Set networking, Redis, and
# public URLs explicitly. See docs/HYBRID_DEPLOYMENT.md.
# -----------------------------------------------------------------------------
DEPLOYMENT_PROFILE=hybrid

# REQUIRED — every hybrid deployment needs stable public URLs for Telnyx
PUBLIC_BASE_URL=https://voice.example.com
AUDIO_PUBLIC_BASE_URL=https://voice.example.com/audio

# REQUIRED — STT/TTS/LLM endpoints reachable from wherever runtime runs
WHISPER_URL=https://gpu-private.example/transcribe
TTS_MODE=chatterbox_http
CHATTERBOX_URL=https://gpu-private.example

# RECOMMENDED — readiness when GPU hosts do not expose /health to cloud runtime
HEALTH_VOICE_DEPENDENCIES=configured

# Redis must be reachable from the voice runtime (same VPC or low-latency path)
REDIS_URL=redis://redis.example:6379
