# =============================================================================
# VeraLux — CLOUD-API profile (no local GPU containers)
# =============================================================================
# Copy to .env or merge with your orchestrator secrets manager.
# Use with: ./scripts/deploy-profile.sh --profile cloud-api [--env-file this-file]
#
# REQUIRED — core
# -----------------------------------------------------------------------------
DEPLOYMENT_PROFILE=cloud-api
POSTGRES_USER=veralux
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=veralux
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
ADMIN_API_KEY=CHANGE_ME_GENERATE_SECURE_KEY
SECRET_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_UTF8_SECRET_MIN_32B
SECRET_MANAGER=db
MEDIA_STREAM_TOKEN=CHANGE_ME_GENERATE_SECURE_TOKEN

# REQUIRED — public URLs (must be reachable from Telnyx)
PUBLIC_BASE_URL=https://voice.example.com
AUDIO_PUBLIC_BASE_URL=https://voice.example.com/audio
BASE_URL=https://control.example.com
ADMIN_ALLOWED_ORIGINS=https://control.example.com

# REQUIRED — Telnyx
TELNYX_API_KEY=CHANGE_ME
TELNYX_PUBLIC_KEY=CHANGE_ME
TELNYX_PHONE_NUMBER=+15551234567
TELNYX_VERIFY_SIGNATURES=true

# STT — Whisper HTTP or native cloud (openai_whisper / deepgram via tenant pipeline)
WHISPER_URL=https://stt-provider.example.com/v1/transcribe
DEEPGRAM_API_KEY=

# TTS — Kokoro is the only live engine (needs a reachable Kokoro HTTP URL)
TTS_MODE=kokoro_http
KOKORO_URL=https://tts-provider.example.com/tts
ELEVENLABS_API_KEY=

CLOUD_BIND_EXACT_PORT=1

# If TTS_MODE=chatterbox_http, set CHATTERBOX_URL to an external HTTPS base (not docker hostname chatterbox:7005).
# CHATTERBOX_URL=https://chatterbox-gateway.example.com
# CHATTERBOX_VARIANT=turbo

# LLM — control plane + optional HTTP brain
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# Voice readiness — use configured when providers lack VeraLux-style GET /health
HEALTH_VOICE_DEPENDENCIES=configured

# OPTIONAL — explicit health probes (strict mode uses these when set)
# STT_HEALTH_URL=https://stt-provider.example.com/health
# TTS_HEALTH_URL=https://tts-provider.example.com/health
# LLM_HEALTH_URL=https://brain.example.com/health

# OPTIONAL — Redis (omit when using default docker-compose.yml bundled `redis` service; Compose sets REDIS_URL on control/runtime)
# REDIS_URL=redis://your-managed-redis:6379/0

# OPTIONAL — images / ports
VERSION=0.1.0
REGISTRY=ghcr.io/nick-veraluxai
CONTROL_PORT=4000
RUNTIME_PORT=4001

# OPTIONAL — price refresh + host provision (hub only)
# PRICE_REFRESH_ENABLED=true
# PRICE_REFRESH_INTERVAL_MS=21600000
# RENDER_API_KEY=
# RAILWAY_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# OPENROUTER_API_KEY=

# OPTIONAL — Stripe, SMTP, tunnels (see root .env.example)
# STRIPE_SECRET_KEY=
