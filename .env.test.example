NODE_ENV=test

# Test-only infra endpoints (docker-compose.test.yml defaults)
DATABASE_URL=postgres://veralux_test:veralux_test@127.0.0.1:55432/veralux_test
REDIS_URL=redis://127.0.0.1:56379

# Test-only dummy secrets/keys (never real production values)
ADMIN_API_KEY=test-admin-key
ADMIN_JWT_SECRET=test-admin-jwt-secret-with-minimum-length-123456
JWT_SECRET=test-jwt-secret-with-minimum-length-123456
API_KEY=test-control-api-key
CONTROL_PLANE_API_KEY=test-control-plane-api-key
VOICE_CONTROL_API_KEY=test-voice-control-api-key

TELNYX_API_KEY=test_telnyx_api_key
TELNYX_PUBLIC_KEY=test_telnyx_public_key
TELNYX_WEBHOOK_SECRET=test_telnyx_webhook_secret
TELNYX_VERIFY_SIGNATURES=true
TELNYX_SKIP_SIGNATURE=false

PUBLIC_BASE_URL=http://127.0.0.1:4001
AUDIO_PUBLIC_BASE_URL=http://127.0.0.1:4001/audio
MEDIA_STREAM_TOKEN=test_media_stream_token
AUDIO_STORAGE_DIR=/tmp/veralux-test-audio
WHISPER_URL=http://127.0.0.1:9000/transcribe
STT_CHUNK_MS=500
STT_SILENCE_MS=800
DEAD_AIR_MS=10000
GLOBAL_CONCURRENCY_CAP=16
TENANT_CONCURRENCY_CAP_DEFAULT=4
TENANT_CALLS_PER_MIN_CAP_DEFAULT=60
CAPACITY_TTL_SECONDS=3600
