# =============================================================================
# Veralux Receptionist — operator environment (.env)
# =============================================================================
# DEVELOPMENT ONLY: repo `.env` is for laptops and CI clones. Managed production
# uses `/etc/veralux/voice-runtime.env` + `docker-compose.production.yml` + `scripts/start-production.sh`.
# See PRODUCTION_TOPOLOGY.md.
#
# Copy to .env and fill in values. Never commit `.env`.
#
# Local start: `./up` or `./deploy.sh up`
#
# Advanced STT/TTS tuning, GPU mapping, debug flags, and capacity knobs live in
# optional .env.internal (see .env.internal.example). If .env.internal exists,
# deploy.sh passes it to Docker Compose after .env (later file wins for duplicates).
# =============================================================================

# --- Images (pin for production; avoid VERSION=latest on managed hosts) ---
# See RELEASE_CHANNELS.md and UPGRADE_RUNBOOK.md.
VERSION=0.1.0
REGISTRY=ghcr.io/nick-veraluxai

# --- PostgreSQL ---
POSTGRES_USER=veralux
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=veralux

# --- Security (generate strong random values) ---
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
ADMIN_API_KEY=CHANGE_ME_GENERATE_SECURE_KEY
# When SECRET_MANAGER=db, the control plane requires at least 32 UTF-8 bytes (see secretStore.ts). Replace in real .env with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SECRET_MANAGER=db
MEDIA_STREAM_TOKEN=CHANGE_ME_GENERATE_SECURE_TOKEN

# --- Public URLs (required for real Telnyx / browser access) ---
BASE_URL=http://localhost:4000
PUBLIC_BASE_URL=https://your-domain.com
AUDIO_PUBLIC_BASE_URL=https://your-domain.com/audio
ADMIN_ALLOWED_ORIGINS=http://localhost:4000

# --- Ports (host mapping) ---
CONTROL_PORT=4000
RUNTIME_PORT=4001

# --- Telnyx (voice) — https://portal.telnyx.com ---
TELNYX_API_KEY=CHANGE_ME
TELNYX_PUBLIC_KEY=CHANGE_ME
TELNYX_PHONE_NUMBER=
TELNYX_VERIFY_SIGNATURES=true

# --- LLM (cloud default) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# --- Voice engine (Whisper + TTS run in Docker; deploy.sh picks gpu/cpu profile) ---
# coqui_xtts | kokoro_http | qwen3_tts_http | chatterbox_http (GPU only)
TTS_MODE=coqui_xtts

# Hugging Face read token — required for Chatterbox / Qwen3 gated models
HF_TOKEN=

# --- Optional: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: SMTP (workflow email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@veralux.ai

# --- Optional: tunnels ---
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_TAG=
NGROK_AUTHTOKEN=
NGROK_TAG=

# --- Optional: installer UI (install.sh admin mode) ---
INSTALLER_USERNAME=VeraLux
# INSTALLER_PASSWORD=   # unset = use ADMIN_API_KEY for /admin-auth
# Online installer (export before ./install.sh, or set in shell profile — install.sh does not auto-load .env):
# INSTALLER_CONFIG_API_URL=https://api.example.com/api/v1/installer/config
# INSTALLER_SIGNUP_URL=https://example.com/signup

# --- White-label / product copy (control plane; see CUSTOMER_CONFIG_SURFACE.md) ---
# BRAND_NAME=Acme
# BRAND_LOGO_URL=https://example.com/logo.png
# BRAND_LOGO_URL=          # empty string = hide logos
# BRAND_ADMIN_TAGLINE=Acme Receptionist · Live control plane
# BRAND_PORTAL_FOOTER_DISABLED=true
# BRAND_PORTAL_FOOTER_URL=https://example.com
# BRAND_PORTAL_FOOTER_LINK_TEXT=Acme
# PRODUCT_DISPLAY_NAME=Acme Receptionist
# TELNYX_CONNECTION_DISPLAY_NAME=Acme Voice
# DEFAULT_RECEPTIONIST_SYSTEM_PREAMBLE=You are the AI receptionist for this business.
# SMTP_FROM=noreply@yourdomain.com

# --- Optional: logging ---
LOG_LEVEL=info

# --- Portable deployment (Sprint 2A) ---
# local-gpu | cloud-api | hybrid — unset defaults to existing local workstation / GPU stack behavior.
# DEPLOYMENT_PROFILE=local-gpu
#
# Voice readiness: strict (default, legacy true) | configured | disabled (legacy false).
# HEALTH_VOICE_DEPENDENCIES=strict
#
# Optional explicit health probes (strict mode uses these instead of deriving /health from WHISPER_URL / TTS URLs):
# STT_HEALTH_URL=
# TTS_HEALTH_URL=
# LLM_HEALTH_URL=
#
# Brain HTTP readiness (strict /health/voice): default false — unreachable brain does not fail voice health.
# Set true when the HTTP brain (compose --profile llm) must be running.
# BRAIN_HEALTH_REQUIRED=false
#
# REDIS_URL may be omitted from split files such as /etc/veralux/voice-runtime.env when the standard
# Compose graph supplies it (see docker-compose.yml). scripts/preflight-profile.sh accepts that model.
# Optional merge for scripts only: ./scripts/preflight-profile.sh ... --fragment-env path/to/extra.env
