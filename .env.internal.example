# =============================================================================
# Veralux Receptionist — internal / advanced overrides (.env.internal)
# =============================================================================
# Copy to .env.internal beside .env (optional). Never commit real .env.internal.
#
# Purpose:
#   - STT/TTS pipeline tuning, capacity, debug dumps, GPU device indices
#   - Service URLs if not using default Docker network names
#   - vLLM / brain / benchmark / build stamps
#
# Precedence: Docker Compose loads .env then .env.internal (duplicate keys: internal wins).
# deploy.sh always passes --env-file .env.internal when this file exists.
#
# Operators should keep secrets in .env when possible; use this file for tuning.
# =============================================================================

# --- Build / UI fingerprint (local image builds) ---
# ADMIN_UI_BUILD_STAMP=
# ADMIN_UI_BUILD_STAMP_NO_GIT=1

# --- White-label (control plane UI; see CUSTOMER_CONFIG_SURFACE.md) ---
# BRAND_NAME=
# BRAND_LOGO_URL=
# BRAND_WORDMARK_URL=
# BRAND_PORTAL_FOOTER_DISABLED=true
# PRODUCT_DISPLAY_NAME=

# --- Voice runtime health (see HEALTH_MODEL.md) ---
# Default true: GET /health/ready checks Whisper + TTS HTTP. Set false only for redis-only / dev gates.
# HEALTH_VOICE_DEPENDENCIES=false

# --- Control plane (optional flags — see control-plane/docs/configuration.md) ---
# ENABLE_RUNTIME_ADMIN=true
# ALLOW_RUNTIME_SECRET_READ=false
# ADMIN_AUTH_MODE=hybrid
# ALLOW_ADMIN_API_KEY_IN_PROD=true
# REQUEST_TIMEOUT_MS=30000
# TTS_PREVIEW_FETCH_TIMEOUT_MS=90000
# VOICE_RECORDINGS_DIR=
# VOICE_RECORDING_MAX_SIZE_MB=10
# VOICE_RECORDINGS_BASE_URL=
# VOICE_RUNTIME_URL=http://localhost:8000
# DEFAULT_TENANT_ID=
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=2

# --- Local LLM (when LLM_PROVIDER=local) ---
# OpenAI-compatible chat URL (Nemotron / vLLM). llama.cpp /completion also still works.
# LOCAL_LLM_URL=http://host.docker.internal:8082/v1/chat/completions
# OPENAI_BASE_URL=

# --- Telnyx fine-tuning ---
# TELNYX_ACCEPT_CODECS=PCMU,AMR-WB
# TELNYX_AMRWB_DECODE=true
# PLAYBACK_PSTN_SAMPLE_RATE=16000
# TELNYX_CONNECTION_ID=
# TELNYX_WEBHOOK_SECRET=

# --- TTS service URLs (defaults match in-network Docker aliases) ---
# KOKORO_URL=http://kokoro:7001/tts
# XTTS_URL=http://xtts:7002
# COQUI_XTTS_URL=http://xtts:7002/tts
# CHATTERBOX_URL=http://chatterbox:7005
# CHATTERBOX_VARIANT=turbo
# CHATTERBOX_DEVICE=cuda
# CHATTERBOX_STREAMING=false
# CHATTERBOX_GUNICORN_WORKERS=1
# CHATTERBOX_SPEAKER_CACHE_DIR=/tmp/chatterbox_speaker_cache
# CHATTERBOX_PRELOAD_SPEAKER_URLS=
# CHATTERBOX_STREAM_MAX_SEGMENTS=8
# QWEN3_TTS_URL=http://veralux-qwen3-tts:7010
# QWEN3_TTS_SPEAKER=Ryan
# QWEN3_TTS_LANGUAGE=English
# MISO_TTS_URL=http://veralux-miso-tts:7011
# MISO_TTS_SPEAKER=0
# MISO_TTS_GPU_IDS=0

# --- STT / Whisper client ---
# WHISPER_URL=http://whisper:9000/transcribe
# WHISPER_PORT=9000
# WHISPER_HTTP_KEEPALIVE=true
# WHISPER_HTTP_MAX_CONNECTIONS=8
# STT_CHUNK_MS=100
# STT_SILENCE_MS=700
# STT_MIN_SPEECH_MS_TO_FINALIZE=280
# STT_MIN_SPEECH_BYTES_TO_FINALIZE=8000
# STT_LANGUAGE=en
# STT_AEC_ENABLED=true
# STT_RX_HEADROOM_DB=-3
# STT_POST_PLAYBACK_GRACE_MS=900
# STT_POST_PLAYBACK_GRACE_MIN_MS=400
# STT_POST_PLAYBACK_GRACE_MAX_MS=1100
# STT_RX_POSTPROCESS_ENABLED=true
# STT_RX_DEDUPE_WINDOW=48
# STT_UNCLEAR_REPROMPT_ENABLED=true
# STT_EMPTY_FINAL_EXTRA_TRIES=1
# STT_FINAL_ERROR_EXTRA_TRIES=1
# STT_FINAL_RETRY_BACKOFF_MS=180
# STT_UNCLEAR_REPROMPT_MAX_PER_CALL=8
# STT_UNCLEAR_REPROMPT_COOLDOWN_MS=2200
# STT_TRANSCRIPT_DEDUPE_ENABLED=true
# STT_TRANSCRIPT_DEDUPE_WINDOW_MS=2200
# STT_TRANSCRIPT_DEDUPE_SIMILARITY=0.9
# MEDIA_SEQ_GAP_LOG_MIN=3
# STT_PIPELINE_DIAG_INTERVAL_MS=0
# STT_PIPELINE_DIAG_ON_PLAYBACK=true
# DEAD_AIR_MS=10000

# --- STT debug (disk I/O; disable in production unless diagnosing) ---
# STT_DEBUG_DIR=/app/audio/stt-debug
# STT_DEBUG_DUMP_RX_WAV=false
# STT_DEBUG_AEC_NEAR_OUT_WAV=false
# STT_DEBUG_AEC_TAP_MAX_MS=8000
# STT_DEBUG_DUMP_WHISPER_WAVS=false
# STT_DEBUG_DUMP_PCM16=false
# STT_DEBUG_DUMP_FAR_END_REF=false
# STT_PREWHISPER_GATE=false
# STT_PREWHISPER_DEDUPE_WINDOW=32
# STT_PREWHISPER_DEDUPE_MIN_PEAK_ABS=280
# STT_PREWHISPER_DUMP_DIR=/app/audio/stt-debug
# STT_PREWHISPER_DUMP_FIRST_N=10
# STT_RX_DEDUPE_MIN_PEAK=

# --- Capacity / rate limits (mis-tuning can block calls) ---
# GLOBAL_CONCURRENCY_CAP=16
# TENANT_CONCURRENCY_CAP_DEFAULT=4
# TENANT_CALLS_PER_MIN_CAP_DEFAULT=60
# CAPACITY_TTL_SECONDS=3600
# CAPACITY_HOLD_ENABLED=true
# CAPACITY_HOLD_MAX_SECONDS=300
# CAPACITY_HOLD_POLL_INTERVAL_MS=4000
# CAPACITY_HOLD_MESSAGE=Please hold while we connect you.
# CAPACITY_HOLD_TIMEOUT_MESSAGE=We're still busy. Please try your call again later.
# CAPACITY_HOLD_AUDIO_URL=

# --- GPU / model selection (audio stack containers) ---
# WHISPER_MODEL=large-v3
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_GPU_IDS=1
# CHATTERBOX_GPU_IDS=0
# KOKORO_PORT=7001
# KOKORO_VOICE_ID=default
# KOKORO_GPU_IDS=0
# XTTS_PORT=7002
# XTTS_LANGUAGE=en
# XTTS_GPU_IDS=0
# QWEN3_TTS_GPU_IDS=0
# QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice

# --- Optional local LLM stack (profile llm) ---
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# VLLM_PORT=8000
# VLLM_GPU_IDS=1
# VLLM_GPU_MEMORY_UTILIZATION=0.6
# VLLM_MAX_NUM_SEQS=24
# VLLM_MAX_MODEL_LEN=8192
# VLLM_IMAGE=vllm/vllm-openai:cu130-nightly-x86_64
# VLLM_OPENAI_API_KEY=EMPTY
# BRAIN_URL=http://brain:3001
# BRAIN_USE_LOCAL=false

# --- Brain / API_KEY passthrough (compose sets API_KEY on control; rarely needed) ---
# API_KEY=

# --- Storage path inside runtime container ---
# AUDIO_STORAGE_DIR=/app/audio

# --- PostgRES host port (debug only; uncomment in docker-compose to publish) ---
# POSTGRES_PORT=5432
