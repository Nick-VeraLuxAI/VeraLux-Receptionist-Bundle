# Leave REACT_APP_CONTROL_PLANE_URL empty in production so the SPA is same-origin
# with the control plane (fetch("/api/...")).
#
# Local `npm start` uses src/setupProxy.js → http://127.0.0.1:4000
# Override the proxy target:
# CONTROL_PLANE_PROXY=http://127.0.0.1:4000
#
# Only set this if the UI is hosted on a different origin than the API:
# REACT_APP_CONTROL_PLANE_URL=http://127.0.0.1:4000
REACT_APP_CONTROL_PLANE_URL=
