# Example keys for Ubuntu production (populate on the host — do NOT commit populated files).
# Authoritative paths are documented in PRODUCTION_TOPOLOGY.md.

# openssl rand -base64 32  (examples only — rotate and store in /etc/veralux/voice-runtime.env)
JWT_SECRET=PASTE_STRONG_RANDOM
ADMIN_API_KEY=PASTE_STRONG_RANDOM
API_KEY=PASTE_STRONG_RANDOM_OR_MATCH_ADMIN
SECRET_ENCRYPTION_KEY=PASTE_STRONG_RANDOM
MEDIA_STREAM_TOKEN=PASTE_STRONG_RANDOM
POSTGRES_PASSWORD=PASTE_STRONG_RANDOM

PUBLIC_BASE_URL=https://voice.veralux.ai
AUDIO_PUBLIC_BASE_URL=https://voice.veralux.ai/audio
BASE_URL=https://voice.veralux.ai
WHISPER_URL=http://whisper:9000/transcribe
CHATTERBOX_URL=http://chatterbox:7005
TTS_MODE=chatterbox_http

# Hugging Face read token — required when Chatterbox/Qwen gated downloads need auth
HF_TOKEN=PASTE_HF_READ_TOKEN_HERE
