{
  "name": "veralux-receptionist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev_with_services.sh",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "build:dev-console": "esbuild src/dev-console.ts --bundle --format=esm --outfile=public/dev-console.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "db:status": "node scripts/migrate.js status",
    "report:runtime": "npm run build && node scripts/print_runtime_contract.js",
    "check:contract": "node -r ts-node/register scripts/check_contract_compat.ts",
    "seed:stage1": "node scripts/seed_stage1_test.js",
    "seed:veralux-internal": "node scripts/seed-veralux-internal-tenant.cjs",
    "test": "npm run build && node --test tests/auth.test.js tests/ownerAuth.test.js tests/consoleAuth.test.js tests/validation.test.js tests/runtimeContract.test.js tests/runtimePublisher.test.js tests/receptionist.test.js tests/planLimits.test.js tests/redaction.test.js tests/tenantLimitsDb.test.js tests/sprint0Security.test.js tests/sprint2aSafeApi.test.js tests/callSanitizer.test.js tests/callAnalyticsFromDb.test.js tests/inMemoryCallStore.test.js tests/sprint1ClientReadiness.test.js tests/nightDesk.test.js tests/workflowEngine.test.js tests/workflowTemplates.test.js tests/stripeCatalog.test.js tests/cloudProvisionContract.test.js tests/cloudHosts.test.js tests/cloudApplyRemote.test.js tests/qaCoaching.test.js",
    "test:production-readiness": "../scripts/test-infra.sh wait && npm run build && DATABASE_URL=${DATABASE_URL:-postgres://veralux_test:veralux_test@127.0.0.1:55432/veralux_test} REDIS_URL=${REDIS_URL:-redis://127.0.0.1:56379} node --test tests/productionReadiness.integration.test.js",
    "test:runtime": "npm run build && node --test tests/runtimeContract.test.js tests/runtimePublisher.test.js",
    "test:stage1": "bash scripts/stage1_smoke_test.sh",
    "test:stage2": "bash scripts/stage2_smoke_test.sh",
    "test:pilot-smoke": "npm run build && node scripts/pilot-readiness-smoke.cjs",
    "test:ui-smoke-html": "node scripts/ui-smoke-html.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1045.0",
    "@veralux/shared": "*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.0",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "jose": "^6.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.12.0",
    "redis": "^5.10.0",
    "stripe": "^20.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.10.2",
    "esbuild": "^0.27.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
