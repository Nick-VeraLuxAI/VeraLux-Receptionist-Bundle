# Merged last when: VERALUX_STT_DEBUG=1 ./scripts/start-production.sh
# Paths use the runtime audio volume (/app/audio) so WAVs + JSON survive in Docker.
ALLOW_PROD_DEBUG_CAPTURE=true
CALL_TRANSCRIPT_DIR=/app/audio/call-transcripts
STT_DEBUG_DIR=/app/audio/stt-debug
AMRWB_DEBUG_DIR=/app/audio/stt-debug
STT_PREWHISPER_DUMP_DIR=/app/audio/stt-debug
STT_DEBUG_DUMP_RX_WAV=true
STT_DEBUG_DUMP_WHISPER_WAVS=true
STT_DEBUG_DUMP_PCM16=true
LOG_LEVEL=debug
LOG_REDACT_TRANSCRIPTS=false
AUDIO_DIAGNOSTICS=true
STT_TRACE=true
STT_TRACE_LIMIT=500
STT_PARTIALS_ENABLED=true
STT_TRANSCRIPT_LOG_MAX_CHARS=16000
