# Non-secret production topology overrides. Merge into /etc/veralux/voice-runtime.env
# Rules for /etc/veralux/voice-runtime.env: every active line must be KEY=value or a # comment.
# Values with spaces must be quoted: FOO="one two". Otherwise start-production.sh (set -a; source) fails.
# (preserve existing secrets). Example:
#   python3 scripts/merge-voice-env.py /etc/veralux/voice-runtime.env deploy/production-env-fragment.env | sudo tee /etc/veralux/voice-runtime.env.new && sudo mv ... 
# Or apply keys manually with sudo.

PUBLIC_BASE_URL=https://voice.veralux.ai
AUDIO_PUBLIC_BASE_URL=https://voice.veralux.ai/audio
BASE_URL=https://voice.veralux.ai
WHISPER_URL=http://whisper:9000/transcribe
CHATTERBOX_URL=http://chatterbox:7005
KOKORO_URL=http://kokoro:7001/tts
TTS_MODE=chatterbox_http
HEALTH_VOICE_DEPENDENCIES=true
WHISPER_GPU_IDS=0
CHATTERBOX_GPU_IDS=1
TELNYX_VERIFY_SIGNATURES=true
TELNYX_SKIP_SIGNATURE=false

# ── Optional: on-host LLM (vLLM + brain-gpt4o, compose profile `llm`) ─────────────────────────
# start-production.sh auto-enables profile llm when any of:
#   VERALUX_ENABLE_LOCAL_LLM=1|true, or VERALUX_EXTRA_COMPOSE_PROFILES contains llm, or
#   BRAIN_USE_LOCAL is false and BRAIN_URL points at http://brain…
# Voice runtime: HTTP brain → vLLM requires BRAIN_USE_LOCAL=false (true = in-process keyword brain only).
# BRAIN_URL may be http://brain:3001 or http://brain:3001/reply — health checks use GET /health on the brain service.
# Pin vLLM to a GPU that does not overlap STT/TTS unless you accept shared VRAM (see WHISPER_GPU_IDS / CHATTERBOX_GPU_IDS).
# VERALUX_ENABLE_LOCAL_LLM=1
# BRAIN_USE_LOCAL=false
# BRAIN_URL=http://brain:3001
# VLLM_GPU_IDS=2
# VLLM_OPENAI_API_KEY=EMPTY
# Control-plane admin LLM via same vLLM OpenAI server (not LLM_PROVIDER=local; that mode expects llama.cpp completion JSON):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://vllm-qwen:8000/v1/chat/completions
# OPENAI_API_KEY=EMPTY
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Composer defaults set STT_DEBUG_DIR to a path; an empty dir counts as debug in production NODE_ENV — clear it.
STT_DEBUG_DIR=
AMRWB_DEBUG_DIR=
AUDIO_DIAGNOSTICS=false
STT_DEBUG_DUMP_WHISPER_WAVS=false
STT_DEBUG_DUMP_PCM16=false
STT_DEBUG_DUMP_RX_WAV=false
STT_DEBUG_DUMP_FAR_END_REF=false
STT_DEBUG_AEC_NEAR_OUT_WAV=false
