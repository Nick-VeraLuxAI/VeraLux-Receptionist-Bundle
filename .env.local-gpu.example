# =============================================================================
# VeraLux — LOCAL-GPU profile (default workstation behavior when unset)
# =============================================================================
# DEPLOYMENT_PROFILE may be omitted or set to local-gpu.
# Use with: ./scripts/deploy-profile.sh --profile local-gpu
#
# REQUIRED — same core secrets as root .env.example (see there).
# -----------------------------------------------------------------------------
# DEPLOYMENT_PROFILE=local-gpu

# Default strict voice health (legacy HEALTH_VOICE_DEPENDENCIES=true)
HEALTH_VOICE_DEPENDENCIES=strict

# Local Docker DNS defaults (unchanged from docker-compose.yml)
WHISPER_URL=http://whisper:9000/transcribe
TTS_MODE=chatterbox_http
CHATTERBOX_URL=http://chatterbox:7005
CHATTERBOX_VARIANT=turbo

# OPTIONAL — explicit /health overrides (normally derived from WHISPER_URL / TTS URLs)
# STT_HEALTH_URL=
# TTS_HEALTH_URL=
# LLM_HEALTH_URL=

# OPTIONAL — vLLM + brain (compose --profile llm)
# BRAIN_URL=http://brain:3001
# BRAIN_USE_LOCAL=false

# REQUIRED — GPU-gated models
HF_TOKEN=CHANGE_ME_HUGGINGFACE_READ_TOKEN
